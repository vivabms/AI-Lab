FAILURE = "FAILURE"
NIL = []        
def is_variable(t):
    return isinstance(t, str) and t[0].islower()


def is_compound(t):
    return isinstance(t, tuple)       


def occurs_in(var, term):
    if var == term:
        return True
    if is_compound(term):
        return any(occurs_in(var, arg) for arg in term[1:])
    return False


def replace(term, var, value)
    if term == var:
        return value
    if is_compound(term):
        return (term[0],) + tuple(replace(a, var, value) for a in term[1:])
    return term


def apply_subst(term, subst):
    for value, var in subst:
        term = replace(term, var, value)
    return term


def compose(subst, s):
    """SUBST = SUBST U S  (S is also applied to the values already in SUBST)."""
    updated = [(apply_subst(value, s), var) for value, var in subst]
    return updated + s

def unify(psi1, psi2):
    if not is_compound(psi1) or not is_compound(psi2):
        if psi1 == psi2:                   
            return NIL
        if is_variable(psi1):                    
            return FAILURE if occurs_in(psi1, psi2) else [(psi2, psi1)]
        if is_variable(psi2):                    
            return FAILURE if occurs_in(psi2, psi1) else [(psi1, psi2)]
        return FAILURE                            
    if psi1[0] != psi2[0]:
        return FAILURE

    if len(psi1) != len(psi2):
        return FAILURE

    subst = NIL
    args1, args2 = list(psi1[1:]), list(psi2[1:])

    # Step 5: unify argument by argument
    for i in range(len(args1)):
        s = unify(args1[i], args2[i])             # (a)
        if s == FAILURE:                          # (b)
            return FAILURE
        if s != NIL:                              # (c)
            for j in range(i + 1, len(args1)):    # apply S to remaining args
                args1[j] = apply_subst(args1[j], s)
                args2[j] = apply_subst(args2[j], s)
            subst = compose(subst, s)

    return subst


